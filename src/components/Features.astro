---
import Icon from './Icon.astro';

const features = [
  { icon: 'micOff', title: 'Vocal removal', text: 'One click and you have a clean instrumental. Good for karaoke night, covers and practice tracks.', accent: 'var(--stem-vocals)' },
  { icon: 'layers', title: 'Multi-stem separation', text: 'Split into 2, 4 or 5 stems: vocals, drums, bass, piano and everything else.', accent: 'var(--accent)' },
  { icon: 'list', title: 'Batch processing', text: 'Queue a whole album and leave it running. Each song runs in its own process, so if one crashes the rest still finish.', accent: 'var(--stem-bass)' },
  { icon: 'sliders', title: 'Quality presets', text: 'Fast preview, Standard or Best quality. Two engine settings combined into one simple choice.', accent: 'var(--stem-drums)' },
  { icon: 'file', title: 'Your format', text: 'Export WAV, FLAC or MP3 (128–320 kbps). Imports MP3, WAV, FLAC, M4A, AAC, OGG and WMA.', accent: 'var(--stem-piano)' },
  { icon: 'pointer', title: 'Drag & drop', text: 'No command line or setup. Drop songs in, choose an output folder and press go.', accent: 'var(--magenta)' },
  { icon: 'youtube', title: 'YouTube support', text: 'Paste a video or playlist link to send its audio straight into the queue, or just save the video or audio.', accent: '#ff4d6d' },
  { icon: 'wifiOff', title: 'Offline after first use', text: 'Each AI model downloads once, the first time you use its mode. After that it works with no internet.', accent: 'var(--green)' },
] as const;

const steps = [
  { n: '01', title: 'Drop', text: 'Drag songs onto the window, click to browse, or paste a YouTube link.' },
  { n: '02', title: 'Choose', text: 'Keep the defaults for a quick instrumental, or open Advanced options for stems, quality and format.' },
  { n: '03', title: 'Done', text: 'Your stems are saved to the output folder, one ✅ per song as each one finishes.' },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Features</span>
      <h2>Studio-grade separation.<br /><span class="grad-text">Zero studio required.</span></h2>
      <p>The settings stay hidden until you want them. Beginners get one big button, and power users get every control under Advanced options.</p>
    </div>

    <div class="grid">
      {
        features.map((f, i) => (
          <article class="card glass spot" data-reveal style={`--delay:${(i % 4) * 0.06}s; --a:${f.accent}`}>
            <span class="card-icon">
              <Icon name={f.icon} size={22} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))
      }
    </div>

    <div class="steps-wrap" id="how">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Three steps</span>
        <h2>Drag. Drop. Done.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--delay:${i * 0.1}s`}>
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .card {
    padding: 26px 22px 24px;
    transition: transform 0.3s;
  }
  .card:hover {
    transform: translateY(-4px);
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    color: var(--a);
    background: color-mix(in srgb, var(--a) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--a) 35%, transparent), 0 0 24px -6px var(--a);
  }
  .card h3 {
    margin-top: 20px;
    font-size: 1.12rem;
  }
  .card p {
    margin-top: 8px;
    font-size: 0.92rem;
    color: var(--muted-2);
    line-height: 1.55;
  }

  .steps-wrap {
    margin-top: clamp(80px, 11vw, 130px);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 33px;
    left: 16%;
    right: 16%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--magenta), var(--accent), var(--blue), transparent);
    opacity: 0.6;
  }
  .step {
    position: relative;
    text-align: center;
    padding: 0 12px;
  }
  .step-n {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-weight: 500;
    color: #fff;
    background: radial-gradient(circle at 30% 30%, #2a2050, #12121e 70%);
    border: 1px solid var(--line-strong);
    box-shadow: 0 0 0 6px var(--bg), 0 0 30px -4px rgba(124, 92, 255, 0.7);
  }
  .step h3 {
    margin-top: 20px;
    font-size: 1.5rem;
  }
  .step p {
    margin: 8px auto 0;
    max-width: 300px;
    color: var(--muted-2);
    font-size: 0.95rem;
  }

  @media (max-width: 1020px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .steps::before {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
