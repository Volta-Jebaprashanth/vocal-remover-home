const isBrand = name in brands;
const body = isBrand ? brands[name as keyof typeof brands] : paths[name as keyof typeof paths];
---

{
  isBrand ? (
    <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
  ) : (
    <svg
      class={cls}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={body}
    />
  )
}
