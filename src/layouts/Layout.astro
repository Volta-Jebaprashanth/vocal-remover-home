---
import '../styles/global.css';
import { CONTACT, REPO } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vocal Remover — Free AI vocal remover & stem splitter for Windows',
  description = 'Turn any song into a clean instrumental, or split it into vocals, drums, bass, piano and more. Free AI-powered Windows app. Runs 100% on your PC — no uploads, no Python, no setup.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Vocal Remover',
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'MultimediaApplication',
  description,
  url: canonical.href,
  image: ogImage.href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: CONTACT.name, email: CONTACT.email, url: CONTACT.linkedin },
  downloadUrl: `https://github.com/${REPO}/releases/latest`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={CONTACT.name} />
    <meta name="theme-color" content="#07070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-glow bg-glow--a"></div>
      <div class="bg-glow bg-glow--b"></div>
      <div class="bg-glow bg-glow--c"></div>
      <div class="bg-noise"></div>
    </div>
    <slot />

    <script>
      // Reveal-on-scroll for any [data-reveal] element.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Spotlight that follows the cursor inside .glass cards.
      document.addEventListener('pointermove', (ev) => {
        const card = (ev.target as HTMLElement).closest?.('.spot') as HTMLElement | null;
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${ev.clientX - r.left}px`);
        card.style.setProperty('--my', `${ev.clientY - r.top}px`);
      });
    </script>
  </body>
</html>
